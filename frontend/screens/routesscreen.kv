#:import dp kivy.metrics.dp

<RoutesScreen>:
    on_kv_post:
        print("RoutesScreen KV applied successfully!")
   
    BoxLayout:
        orientation: "vertical"

        # ---------- HEADER ----------
        BoxLayout:
            size_hint_y: None
            height: "60dp"
            padding: "10dp"
            spacing: "10dp"
            canvas.before:
                Color:
                    rgba: 0.15, 0.15, 0.18, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: "< Back"
                size_hint_x: None
                width: "80dp"
                on_release:
                    app.root.current = "login"

            Label:
                text: "Select Route"
                font_size: "22sp"
                bold: True
                color: 1, 1, 1, 1

            Button:
                text: "Alerts"
                size_hint_x: None
                width: "80dp"
                background_normal: ""
                background_color: 1, 0.6, 0, 1
                color: 1, 1, 1, 1
                on_release:
                    app.root.get_screen("alerts").previous_screen = "routes"
                    app.root.current = "alerts"

        # ---------- PERSONALIZED DASHBOARD (FAVOURITES) ----------
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: "110dp"
            padding: "6dp"
            spacing: "2dp"
            canvas.before:
                Color:
                    rgba: 0.2, 0.2, 0.23, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: "Pinned Commutes"
                font_size: "14sp"
                bold: True
                size_hint_y: None
                height: "20dp"
                halign: "left"
                valign: "middle"
                text_size: self.size

            # Option B: Helper label shown when list is empty
            Label:
                text: "No pinned commutes yet. Add stops from route details!"
                font_size: "13sp"
                color: 0.7, 0.7, 0.7, 1
                size_hint_y: None
                height: "25dp"
                opacity: 1 if not root.favourites else 0
                halign: "left"
                valign: "middle"
                text_size: self.size

            RecycleView:
                id: favourites_rv
                viewclass: "FavouriteItem"
                data: root.favourites

                RecycleBoxLayout:
                    orientation: "horizontal"
                    default_size: None, dp(65)
                    default_size_hint: None, 1
                    size_hint_x: None
                    width: self.minimum_width
                    spacing: dp(6)

        # ---------- ROUTES LIST ----------
        RecycleView:
            id: rv
            viewclass: "RouteItem"
            data: root.rv_data

            RecycleBoxLayout:
                orientation: "vertical"
                default_size: None, dp(56)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(4)


# ---------- ROUTE ITEM TEMPLATE ----------
<RouteItem@Button>:
    text: ""
    route_id: ""
    size_hint_y: None
    height: "56dp"
    font_size: "18sp"
    background_normal: ""
    background_color: 0.25, 0.25, 0.28, 1
    color: 1, 1, 1, 1

    on_release:
        app.root.get_screen("routes").select_route(self.route_id)


# ---------- FAVOURITE ITEM TEMPLATE ----------
<FavouriteItem@Button>:
    text: f"{root.nickname}\nID: {root.stop_id}"
    size_hint_x: None
    width: "135dp"
    background_normal: ""
    background_color: 0.3, 0.5, 0.8, 1
    color: 1, 1, 1, 1
    font_size: "12sp"
    halign: "center"
    valign: "middle"
    text_size: self.width - dp(10), self.height - dp(10)
    on_release:
        app.root.get_screen("routes").select_favourite(root)